    "@types/express-session": "^1.18.4",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
